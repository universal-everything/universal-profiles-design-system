            "label": "footwear, a shoe or a sneaker rejected",
            "pattern": "\\b(footwear|shoes?|sneakers?)\\b",
            "flags": "i"
          },
          {
            "label": "a swoosh, stripe, logo or emblem rejected",
            "pattern": "\\b(swoosh(es)?|stripes?|logos?|emblems?)\\b",
            "flags": "i"
          },
          {
            "label": "a word, letter or monogram rejected",
            "pattern": "\\b(words?|letters?|monograms?)\\b",
            "flags": "i"
          }
        ]
      },
      "top-plane-cleanup": {
        "$description": "The visible top planes of the UP! cubes made smooth, continuous and gently convex so the cubes read as sealed solid dice at any size: only the top planes are edited, the front faces are unchanged, no object is added or removed, and insets, recesses, seams, receptacles and anything entering or emerging from a cube are rejected.",
        "promptRequirements": [
          {
            "label": "only the top planes edited",
            "pattern": "\\b(edit|change) only\\b[^.;\\n]*\\btop planes?\\b",
            "flags": "i",
            "scope": "affirmative"
          },
          {
            "label": "a smooth, continuous, convex top surface",
            "pattern": "\\b(smooth|continuous|convex)\\b[^.;\\n]*\\b(surface|plane)s?\\b",
            "flags": "i",
            "scope": "affirmative"
          },
          {
            "label": "the cubes read as sealed solid dice",
            "pattern": "\\bread\\b[^.;\\n]*\\bsealed solid\\b",
            "flags": "i",
            "scope": "affirmative"
          },
          {
            "label": "the front faces unchanged",
            "pattern": "\\bdo not change front faces\\b",
            "flags": "i",
            "scope": "prompt"
          },
          {
            "label": "no object added or removed",
            "pattern": "\\badd/remove objects\\b|\\badd or remove objects\\b",
            "flags": "i",
            "scope": "prompt"
          }
        ],
        "avoidRequirements": [
          {
            "label": "an inset or recess rejected",
            "pattern": "\\b(insets?|recess\\w*)\\b",
            "flags": "i"
          },
          {
            "label": "a seam or receptacle rejected",
            "pattern": "\\b(seams?|receptacles?)\\b",
            "flags": "i"
          },
          {
            "label": "anything entering or emerging from a cube rejected",
            "pattern": "\\b(entering|emerging)\\b[^\\n]*\\bcubes?\\b",
            "flags": "i"
          }
        ]
      },
      "occlusion-removal": {
        "$description": "A background object that a cube's top edge cut off (the cone-shaped sculpture) removed so that nothing touches or appears to emerge from the cube top: only the named sculpture is removed, visible background separates the cube top from every object, the UP! cubes are not moved or reshaped, and cones, bells, objects touching or behind the cube top, protrusions and anything entering or emerging from a cube are rejected.",
        "promptRequirements": [
          {
            "label": "only the named sculpture removed",
            "pattern": "\\bremove only\\b",
            "flags": "i",
            "scope": "prompt"
          },
          {
            "label": "clear separation between the cube and its surroundings",
            "pattern": "\\bseparat\\w*\\b[^.;\\n]*\\bcubes?\\b|\\bcubes?\\b[^.;\\n]*\\bseparat\\w*\\b",
            "flags": "i",
            "scope": "affirmative"
          },
          {
            "label": "visible background between the cube top and every object",
            "pattern": "\\bvisible background\\b[^.;\\n]*\\bcube top\\b",
            "flags": "i",
            "scope": "affirmative"
          },
          {
            "label": "nothing emerging from or touching the cube top",
            "pattern": "\\bnothing may\\b[^.;\\n]*\\b(emerge|touch)\\w*\\b",
            "flags": "i",
            "scope": "prompt"
          },
          {
            "label": "the UP! cubes not moved or reshaped",
            "pattern": "\\bdo not move or reshape\\b[^.;\\n]*\\bUP! cubes?\\b",
            "flags": "i",
            "scope": "prompt"
          }
        ],
        "avoidRequirements": [
          {
            "label": "a cone or bell rejected",
            "pattern": "\\b(cones?|bells?)\\b",
            "flags": "i"
          },
          {
            "label": "an object touching or behind the cube top rejected",
            "pattern": "\\b(touching|behind)\\b[^\\n]*\\bcube top\\b",
            "flags": "i"
          },
          {
            "label": "a protrusion rejected",
            "pattern": "\\bprotrusions?\\b",
            "flags": "i"
          },
          {
            "label": "anything entering or emerging from a cube rejected",
            "pattern": "\\b(entering|emerging)\\b[^\\n]*\\bcubes?\\b",
            "flags": "i"
          }
        ]
      }
    }
  },
  "edits": {
    "$description": "A file entry may carry an edit block only when it is pinned here: the generation id and kind of the final precise-object edit that produced the file on disk, the SHA-256 of its verbatim edit prompt, and its edit target by hash, generation id and time stamp (superseded and not in the repository). When the target is itself the output of an earlier edit, that edit and every one before it are pinned in lineage, newest first (id, method, prompt hash, output by hash and time stamp, target by hash, generation id and time stamp), and the chain must end at the entry's own generation output. The record entry (edit: id, method, kind, target, lineage, prompt), the staged prompt file (edit: generationId, kind, targetSha256, targetGenerationId, lineage, prompt) and the set's edits block must agree; no target or output may be a pinned file or a reference; the final edit prompt must meet the core edit contract, the rules of its kind and none of the promptNegations, and a lineage prompt the core edit contract; a file without a pinned edit may not record one, and a chain may not record more or fewer earlier edits than pinned. The entry's generationId stays the generation that produced the scene, and its prompt stays that generation prompt."
  },
