  "geometry": {
    "$description": "The closed-cube contract (decision 0013): the Universal Profile is a container, but the UP! object that stands for it is a solid, closed, sealed cube, a monolithic rounded die with smooth, continuous top and side planes and the white UP! once on the front face; never a hole, slot, lid, rim, cavity or insert, never a flat badge or tile. The check is a keyword and pattern gate over the prompt text, polarity-aware: it matches the listed words and phrases, it cannot read the pixels, and it is not a proof of what a file shows. promptRequirements must match every pinned generation prompt (record and staged file) whatever its hash. avoidRequirements must match the prompt's Avoid lines, so every prompt rejects the openings, the inserts and the protrusions. promptNegations may match nowhere in their scope: scope 'prompt' is the whole prompt (the closed geometry stated in the negative); scope 'affirmative' is the prompt without its Avoid lines and, in every clause (split at full stops and semicolons), without the text from the first negation or removal word on, so an Avoid clause, a 'no lid' clause or a 'Remove any inset' clause never trips a guard while a positively requested opening, insert, object entering or emerging, or flat form does, even when a negation follows it in the same clause. editPromptRequirements and editAvoidRequirements are the core contract of every pinned precise-object edit prompt, final or lineage (a precise-object edit, the closed geometry and the closed or sealed cube tops as invariants, the UP! cubes named and their lettering preserved, only the named region edited, no new text, no watermark, and an Avoid line that rejects an opening and an insert on or from a cube); editKinds adds the rules of each kind of edit, and every final pinned edit names its kind (object-replacement: the object replaced by brand-neutral shapes without text, logo or branding, the cubes not moved or reshaped, footwear, swooshes, stripes, logos, emblems, words, letters and monograms rejected; top-plane-cleanup: only the top planes edited into smooth continuous convex surfaces that read as sealed solid dice, the front faces unchanged, no object added or removed, insets, recesses, seams, receptacles and anything entering or emerging rejected; occlusion-removal: only the named sculpture removed, clear separation and visible background around the cube top, nothing emerging from or touching it, the cubes not moved or reshaped, cones, bells, objects touching or behind the cube top, protrusions and anything entering or emerging rejected); the promptNegations apply to edit prompts too. The rules stay distinct (the tests pin them literally), the listed documents state the contract in the listed words, and no listed document may describe the object in the superseded flat-badge or the rejected open-receptacle form.",
    "promptRequirements": [
      {
        "label": "a solid, sealed cube",
        "pattern": "\\bsolid\\b[^.;\\n]*\\bsealed\\b|\\bsealed\\b[^.;\\n]*\\bsolid\\b",
        "flags": "i",
        "scope": "affirmative"
      },
      {
        "label": "closed",
        "pattern": "\\bclosed\\b",
        "flags": "i",
        "scope": "affirmative"
      },
      {
        "label": "monolithic",
        "pattern": "\\bmonolithic\\b",
        "flags": "i",
        "scope": "affirmative"
      },
      {
        "label": "a smooth, unbroken or uninterrupted top",
        "pattern": "\\b(smooth|unbroken|uninterrupted|continuous)\\b[^.;\\n]*\\btops?\\b|\\btops?\\b[^.;\\n]*\\b(smooth|unbroken|uninterrupted|continuous)\\b",
        "flags": "i",
        "scope": "affirmative"
      },
      {
        "label": "rounded",
        "pattern": "\\brounded\\b",
        "flags": "i",
        "scope": "affirmative"
      },
      {
        "label": "the white UP! on the front face",
        "pattern": "\\bwhite\\b[^.;\\n]*UP![^.;\\n]*\\bfront\\b|\\bfront\\b[^.;\\n]*\\bwhite\\b[^.;\\n]*UP!",
        "flags": "i",
        "scope": "affirmative"
      },
      {
        "label": "the UP! cube named",
        "pattern": "UP! cubes?\\b",
        "scope": "affirmative"
      },
      {
        "label": "no other readable text",
        "pattern": "no other readable text",
        "flags": "i",
        "scope": "prompt"
      },
      {
        "label": "opaque",
        "pattern": "\\bopaque\\b",
        "flags": "i",
        "scope": "affirmative"
      },
      {
        "label": "a layered or dense composition",
        "pattern": "\\b(layered|dense)\\b",
        "flags": "i",
        "scope": "affirmative"
      },
      {
        "label": "an Avoid line",
        "pattern": "^Avoid:",
        "flags": "m",
        "scope": "prompt"
      }
    ],
    "avoidRequirements": [
      {
        "label": "holes, openings, slots, lids, rims or cavities rejected",
        "pattern": "\\b(holes?|openings?|slots?|lids?|rims?|cavit(y|ies))\\b",
        "flags": "i"
      },
      {
        "label": "documents, cards or objects entering or emerging from a cube rejected",
        "pattern": "\\b(documents?|cards?|papers?|objects?)\\b[^\\n]*\\b(entering|emerging)\\b",
        "flags": "i"
      },
      {
        "label": "handles, tabs or protrusions rejected",
        "pattern": "\\b(handles?|tabs?|protrusions?)\\b",
        "flags": "i"
      },
      {
        "label": "transparency rejected",
        "pattern": "\\btransparen(cy|t)\\b",
        "flags": "i"
      },
      {
        "label": "a watermark rejected",
        "pattern": "\\bwatermarks?\\b",
        "flags": "i"
      }
    ],
    "promptNegations": [
      {
        "label": "the closed geometry stated in the negative",
        "scope": "prompt",
        "pattern": "\\b(not|never|no|nor|without|instead of)\\s+(a |an |the |any |fully |completely |entirely |truly )?(closed|sealed|solid|monolithic|unbroken|uninterrupted)\\b",
        "flags": "i"
      },
      {
        "label": "an opening, aperture, lid, slot, hole, cavity, rim or receptacle requested",
        "scope": "affirmative",
        "pattern": "\\b(openings?|apertures?|lids?|lidded|lid seams?|slots?|slotted|holes?|cavit(y|ies)|rims?|receptacles?|hatch(es)?|hinged?|hinges|recess(ed|es)?|indent(ed|ation|ations)?|dimples?|sunken|concave|hollow(ed)?|unsealed|openable|open-top(ped)?)\\b|\\bopen\\s+(top|cube|cubes|box|container|die|dice)s?\\b",
        "flags": "i"
      },
      {
        "label": "an object entering or emerging from a cube, or a cube that opens",
        "scope": "affirmative",
        "pattern": "\\b(insert\\w*|enter\\w*|emerg\\w*|spill\\w*|pour\\w*|protrud\\w*|stick\\w*\\s+out|pok\\w*\\s+out|peek\\w*\\s+out|com(e|es|ing)\\s+out\\s+of|ris\\w*\\s+out\\s+of|float\\w*\\s+out\\s+of|tumbl\\w*\\s+out|slid\\w*\\s+(into|out)|slot\\w*\\s+into|drop\\w*\\s+into|plac\\w*\\s+(inside|into)|tuck\\w*\\s+(inside|into)|inside)\\b[^.;\\n]*\\bcubes?\\b|\\bcubes?\\b[^.;\\n]*\\b(insert\\w*|enter\\w*|emerg\\w*|open(s|ed|ing|able)?|unfold\\w*|inside|hold\\w*\\s+(a|an|cards?|documents?|objects?|papers?))\\b",
        "flags": "i"
      },
      {
        "label": "a flat badge, tile or slab requested",
        "scope": "affirmative",
        "pattern": "\\b(flat|shallow|thin)\\s+(rounded )?(badge|tile|slab|square|rectangle|extrusion|app.icon)s?\\b",
        "flags": "i"
      }
    ],
    "editPromptRequirements": [
      {
