{
  "$description": "Patterns that must never appear in tracked content. Each entry is a JavaScript regular expression (flags in `flags`) with the reason it is forbidden. This file is excluded from the scan so the patterns can be stated here.",
  "patterns": [
    { "pattern": "\\/Users\\/[A-Za-z]", "flags": "", "reason": "absolute local home-directory path" },
    { "pattern": "\\/home\\/[a-z]+\\/", "flags": "", "reason": "absolute local home-directory path" },
    { "pattern": "artifacts\\/universal-profiles-design-system-\\d", "flags": "", "reason": "private research artifact directory" },
    { "pattern": "(figma-audit|private-extracts|SCREENSHOT_INDEX|REMOTE_CONNECTOR|profile-brand-board\\/)", "flags": "", "reason": "private research evidence folder or file" },
    { "pattern": "figma\\.com\\/", "flags": "i", "reason": "Figma URL; cite file keys and node ids instead" },
    { "pattern": "api\\/mcp\\/asset", "flags": "i", "reason": "temporary design-tool asset URL" },
    { "pattern": "(docs|drive|sheets|slides)\\.google\\.com", "flags": "i", "reason": "private document URL" },
    { "pattern": "notion\\.(so|site)", "flags": "i", "reason": "private workspace URL" },
    { "pattern": "(miro\\.com|clickup\\.com)", "flags": "i", "reason": "private board or ticket URL" },
    { "pattern": "\\bDEV-\\d{4,6}\\b", "flags": "", "reason": "private ticket identifier" },
    { "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]{2,}", "flags": "", "reason": "email address" },
    { "pattern": "\\b0A[A-Za-z0-9_-]{17}\\b", "flags": "", "reason": "shared-drive identifier" },
    { "pattern": "\\b1[A-Za-z0-9_-]{32}\\b", "flags": "", "reason": "document identifier" },
    { "pattern": "(?<!\\*)\\.jsonl\\b", "flags": "", "reason": "session or stream log reference (a *.jsonl ignore rule is allowed)" },
    { "pattern": "fundrais", "flags": "i", "reason": "financing material is out of scope for a public repository" },
    { "pattern": "(Bearer [A-Za-z0-9._-]{8,}|figma\\.session|X-Amz-Signature|[?&](token|sig|signature)=)", "flags": "", "reason": "credential, cookie or signed URL" },
    { "pattern": "Gemini_Generated_Image", "flags": "", "reason": "private board asset file name" },
    { "pattern": "\\b1000_F_\\d", "flags": "", "reason": "stock-library file name of unknown rights" },
    { "pattern": "\\bsk-[A-Za-z0-9_-]{20,}", "flags": "", "reason": "API secret key (sk- prefix)" },
    { "pattern": "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{22,}", "flags": "", "reason": "GitHub token" },
    { "pattern": "\\bAKIA[0-9A-Z]{16}\\b", "flags": "", "reason": "AWS access key id" },
    { "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "flags": "", "reason": "private key block" },
    { "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}", "flags": "", "reason": "Slack token" },
    { "pattern": "\\bfigd_[A-Za-z0-9_-]{20,}", "flags": "", "reason": "Figma personal access token" },
    { "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b", "flags": "", "reason": "Google API key" },
    { "pattern": "\\beyJ[A-Za-z0-9_-]{15,}\\.[A-Za-z0-9_-]{15,}\\.[A-Za-z0-9_-]{10,}", "flags": "", "reason": "JSON web token" },
    { "pattern": "_authToken\\s*=", "flags": "", "reason": "npm registry auth token" },
    { "pattern": "\\b[A-Z][A-Z0-9_]*(API_KEY|SECRET|TOKEN|PASSWORD)\\s*=\\s*['\\\"]?[A-Za-z0-9/+_.-]{12,}", "flags": "", "reason": "environment-style credential assignment" },
    { "pattern": "\\bssh-(rsa|ed25519|dss) AAAA[A-Za-z0-9+/]{20,}", "flags": "", "reason": "SSH key material" }
  ]
}
