{
  "tab-bar": {
    "$description": "Bottom navigation: five slots on a glass bar with a raised centre action.",
    "$extensions": { "up": { "status": "observed", "source": "SRC-MOBILE-APP:LUKSOBottomTabBar.tsx; LUKSOBottomTabBarItem.tsx; ProfilesNavigation.tsx", "confidence": "high" } },
    "items": { "$type": "number", "$value": 5 },
    "item-height": { "$type": "dimension", "$value": { "value": 60, "unit": "px" } },
    "action-size": { "$type": "dimension", "$value": { "value": 56, "unit": "px" }, "$description": "Raised centre action button diameter.", "$extensions": { "up": { "status": "open", "open": "OPEN-12", "confidence": "low", "note": "Not read from code; measure in the product." } } },
    "action-fill": { "$type": "color", "$value": "{surface.inverse}" },
    "action-icon": { "$type": "color", "$value": "{text.inverse}" },
    "label": { "$type": "typography", "$value": "{type.label.nav}", "$extensions": { "up": { "status": "normalized", "note": "Follows type.label.nav: rendered semibold at every call site although the style sheet says regular (R-20)." } } },
    "label-color": { "$type": "color", "$value": "{text.default}" },
    "icon-size": { "$type": "dimension", "$value": "{size.icon-m}" },
    "inactive-color": { "$type": "color", "$value": "{interactive.unselected-on-glass}", "$description": "Inactive item icon and label colour.", "$extensions": { "up": { "status": "normalized" } } },
    "inactive-opacity": { "$type": "number", "$value": 1, "$description": "Inactive items use colour, not opacity, so labels stay above 4.5:1.", "$extensions": { "up": { "status": "normalized", "note": "Observed opacity.inactive (0.5) composites ink to about 2.9:1 over the bar." } } },
    "slide-duration": { "$type": "duration", "$value": "{motion.duration.base}" },
    "slide-easing": { "$type": "cubicBezier", "$value": "{motion.easing.out-cubic}", "$extensions": { "up": { "status": "normalized", "note": "Follows the motion easing tokens: CSS bezier approximations of the analytic React Native easing functions." } } },
    "slide-overshoot": { "$type": "dimension", "$value": { "value": 30, "unit": "px" }, "$description": "Extra travel when the bar hides." }
  },
  "top-tabs": {
    "$extensions": { "up": { "status": "observed", "source": "SRC-MOBILE-APP:LUKSOTopTabBarItem.tsx; LUKSOTopTabBarIndicator.tsx", "confidence": "high" } },
    "padding-y": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
    "padding-x": { "$type": "dimension", "$value": "{space.5}" },
    "label": { "$type": "typography", "$value": "{type.title.s}", "$extensions": { "up": { "status": "normalized", "note": "Follows type.title.s: sizes and line heights are observed, the grouping into roles is the normalization." } } },
    "active-color": { "$type": "color", "$value": "{interactive.selected}" },
    "inactive-color": { "$type": "color", "$value": "{interactive.unselected}", "$extensions": { "up": { "status": "normalized", "note": "Follows interactive.unselected: neutral.40 at full opacity replaces neutral.45 at 55 percent (R-07)." } } },
    "inactive-opacity": { "$type": "number", "$value": 1, "$description": "Inactive tabs use interactive.unselected at full opacity.", "$extensions": { "up": { "status": "normalized", "note": "Observed opacity.inactive-top-tab (0.55) on neutral.45 composites to about 2.6:1." } } },
    "indicator-height": { "$type": "dimension", "$value": { "value": 2, "unit": "px" }, "$extensions": { "up": { "status": "normalized", "note": "The indicator is an SVG spanning the device width; 2 is its visible weight." } } },
    "indicator-color": { "$type": "color", "$value": "{interactive.selected}" }
  },
  "header": {
    "$description": "Mobile screen header and the settings pill header.",
    "$extensions": { "up": { "status": "observed", "source": "SRC-MOBILE-APP:ScreenHeader.tsx; SettingsHeader.tsx", "confidence": "high" } },
    "pill-radius": { "$type": "dimension", "$value": "{radius.pill}" },
    "pill-height": { "$type": "dimension", "$value": "{size.control-m}", "$extensions": { "up": { "status": "normalized", "note": "The pill wraps a 44 back button plus padding; 48 is the resulting height." } } },
    "title": { "$type": "typography", "$value": "{type.body.l-strong}", "$extensions": { "up": { "status": "normalized", "note": "Follows type.body.l-strong: sizes and line heights are observed, the grouping into roles is the normalization." } } },
    "title-color": { "$type": "color", "$value": "{text.default}" },
    "badge-fill": { "$type": "color", "$value": "{status.warning.fill}", "$description": "Yellow badge on header icons.", "$extensions": { "up": { "status": "normalized", "note": "Follows status.warning.fill (the normalized warning scale)." } } }
  },
  "app-tile": {
    "$description": "Home app grid tile.",
    "$extensions": { "up": { "status": "observed", "source": "SRC-MOBILE-APP:ProfileAppCard.tsx; AddAppCard.tsx; ProfileAppsList.tsx", "confidence": "high" } },
    "size": { "$type": "dimension", "$value": { "value": 61, "unit": "px" } },
    "radius": { "$type": "dimension", "$value": "{radius.s}" },
    "columns": { "$type": "number", "$value": 4 },
    "column-width": { "$type": "dimension", "$value": "{space.18}", "$description": "Column count derives from floor(width / 72) minus 1." },
    "label": { "$type": "typography", "$value": "{type.label.micro}", "$extensions": { "up": { "status": "normalized", "note": "Follows type.label.micro: sizes and line heights are observed, the grouping into roles is the normalization." } } },
    "label-color": { "$type": "color", "$value": "{text.default}" },
    "add-border": { "$type": "color", "$value": "{border.strong}", "$extensions": { "up": { "status": "normalized", "note": "Observed dashed border #E5E5E5 is off-palette and 1.2:1 on white; border.strong passes 3:1." } } },
    "add-border-width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
    "disabled-opacity": { "$type": "number", "$value": "{opacity.disabled}" }
  },
  "page-indicator": {
    "$extensions": { "up": { "status": "observed", "source": "SRC-MOBILE-APP:home multi-profile paging dots", "confidence": "medium" } },
    "dot-size": { "$type": "dimension", "$value": { "value": 6, "unit": "px" }, "$extensions": { "up": { "status": "proposed" } } },
    "gap": { "$type": "dimension", "$value": "{space.1}" },
    "active": { "$type": "color", "$value": "{text.default}" },
    "inactive": { "$type": "color", "$value": "{text.subtle}" }
  }
}
