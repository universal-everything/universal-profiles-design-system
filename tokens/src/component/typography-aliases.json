{
  "type-alias": {
    "$type": "typography",
    "$description": "Migration map from the mobile app's typography variant names to roles. Each alias resolves to exactly one role so call sites can be rewritten mechanically. Names keep the original spelling; they are deprecated in favour of the role names.",
    "$extensions": { "up": { "status": "obsolete", "source": "SRC-MOBILE-APP:src/shared/ui/components/typography/TypographyStyles.ts (38 variants)", "confidence": "high", "deprecated": true, "note": "Observed variant names kept only so migration is mechanical; new code uses the role names." } },
    "h1": { "$value": "{type.title.l}" },
    "h1-medium": { "$value": "{type.title.l}", "$description": "Duplicate of h1 in production (same size, medium weight)." },
    "h2": { "$value": "{type.title.m}" },
    "h3": { "$value": "{type.title.s}" },
    "h4": { "$value": "{type.label.caps}" },
    "h5": { "$value": "{type.label.l}" },
    "nav-11-regular": { "$value": "{type.label.nav}", "$description": "Rendered semibold at every call site." },
    "button-text": { "$value": "{type.action.l}" },
    "link": { "$value": "{type.action.l}" },
    "paragraph-17-semi-bold": { "$value": "{type.action.l}" },
    "paragraph-16-regular": { "$value": "{type.body.l}" },
    "paragraph-16-semi-bold": { "$value": "{type.body.l-strong}" },
    "paragraph-14-regular": { "$value": "{type.body.m}" },
    "paragraph-14-medium": { "$value": "{type.body.m-medium}" },
    "paragraph-14-semi-bold": { "$value": "{type.body.m-strong}" },
    "paragraph-12-regular": { "$value": "{type.body.s}" },
    "paragraph-12-medium": { "$value": "{type.body.s-medium}" },
    "paragraph-12-semi-bold": { "$value": "{type.body.s-strong}" },
    "paragraph-12-bold": { "$value": "{type.body.s-bold}" },
    "paragraph-10-regular": { "$value": "{type.label.micro}", "$description": "Regular 10 has no role; migrate to micro (medium) or to body.s." },
    "paragraph-10-medium": { "$value": "{type.label.micro}" },
    "paragraph-10-semi-bold": { "$value": "{type.label.micro}" },
    "caption": { "$value": "{type.body.caption}" },
    "currency-10-semi-bold": { "$value": "{type.currency.s}" },
    "currency-10-bold-uppercase": { "$value": "{type.currency.code}" },
    "currency-14-semi-bold": { "$value": "{type.currency.m}" },
    "monospaced-23-bold": { "$value": "{type.mono.xl}" },
    "monospaced-16-regular": { "$value": "{type.mono.l}" },
    "monospaced-16-bold": { "$value": "{type.mono.l-strong}" },
    "monospaced-14-bold": { "$value": "{type.mono.m}" },
    "monospaced-12-regular": { "$value": "{type.mono.s}" },
    "monospaced-12-bold": { "$value": "{type.mono.s-strong}" },
    "monospaced-10-bold": { "$value": "{type.mono.xs}" }
  }
}
